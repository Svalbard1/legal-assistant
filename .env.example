# ============================================================
# Шаблон переменных окружения.
# cp .env.example .env — и заполнить. Секреты в .env не коммитятся.
#
# КТО ЧТО ЧИТАЕТ:
#   docker-compose.yml            -> POSTGRES_* (инициализация контейнера)
#   backend/app/config.py         -> DATABASE_URL, ML_SERVICE_URL (из backend/.env)
#   backend/migrations/env.py     -> POSTGRES_*, ALEMBIC_DB_HOST/PORT
#   backend/tests/conftest.py     -> POSTGRES_* (из корневого .env)
#   ml/service.py                 -> LLM_API_URL
# ============================================================

# --- PostgreSQL: контейнер в docker-compose + тесты (backend/tests) ---
POSTGRES_DB=legal_assistant
POSTGRES_USER=legal_assistant
POSTGRES_PASSWORD=change-me

# --- Backend: подключение к БД (backend/app/config.py -> DATABASE_URL) ---
# Локальный запуск бекенда НА ХОСТЕ: порт 5433 (проброшен из compose).
# ВАЖНО: app/config.py читает backend/.env — скопируй шаблон также туда
# (cp .env.example backend/.env), либо экспортируй переменные в шелле.
DATABASE_URL=postgresql+asyncpg://legal_assistant:change-me@127.0.0.1:5433/legal_assistant

# --- Backend: адрес ML-сервиса (ML-клиент в backend/app) ---
# Локально: порт 8001; в docker-compose сетях: http://ml-service:8001
ML_SERVICE_URL=http://localhost:8001

# --- Миграции Alembic (backend/migrations/env.py) ---
ALEMBIC_DB_HOST=127.0.0.1
ALEMBIC_DB_PORT=5433

# --- ML-сервис: генерация (ml/service.py) ---
# OpenAI-совместимый URL; пусто → режим заглушки (llm="stub")
LLM_API_URL=
