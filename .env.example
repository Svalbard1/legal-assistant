# ============================================================
# Шаблон переменных окружения.
# cp .env.example .env — и заполнить. Секреты в .env не коммитятся.
#
# КТО ЧТО ЧИТАЕТ:
#   compose.yaml                  -> POSTGRES_*, optional LLM_*, VITE_API_BASE_URL
#   backend/app/config.py         -> POSTGRES_* (сама собирает DATABASE_URL),
#                                     опциональный override DATABASE_URL,
#                                     ML_SERVICE_URL (из backend/.env)
#   backend/migrations/env.py     -> POSTGRES_*, ALEMBIC_DB_HOST/PORT
#   backend/tests/conftest.py     -> POSTGRES_* (из корневого .env)
#   ml/service.py                 -> LLM_API_URL/KEY/MODEL (генерация; пусто -> stub)
# ============================================================

# --- PostgreSQL: контейнер compose + бекенд + миграции + тесты ---
POSTGRES_DB=legal_assistant
POSTGRES_USER=legal_assistant
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- Backend: (опционально) готовый DATABASE_URL вместо сборки из POSTGRES_* ---
# Нужен только если хочется нестандартный driver/dsn. Без него config.py
# соберёт postgresql+asyncpg://... из переменных выше.
# DATABASE_URL=postgresql+asyncpg://legal_assistant:change-me@127.0.0.1:5433/legal_assistant

# --- Backend: адрес ML-сервиса ---
# Локально: порт 8001; в docker-compose сетях: http://ml-service:8001
ML_SERVICE_URL=http://localhost:8001

# --- Миграции Alembic (backend/migrations/env.py) ---
ALEMBIC_DB_HOST=127.0.0.1
ALEMBIC_DB_PORT=5433

# --- ML-сервис: генерация (ml/service.py). Пусто -> llm=stub (выжимки).
# Необязательно; OpenAI-совместимый API. Секрет задавайте только локально.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
TEMPERATURE=0.0
MAX_TOKENS=1024

# --- Frontend: URL Backend, встраивается в браузерный bundle при сборке ---
VITE_API_BASE_URL=http://localhost:8000

